{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kevink-im",
  "compatibility_date": "2026-08-09",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // A missing path serves the app shell instead of a 404 — appropriate for
    // a single-page app. Committed explicitly rather than left to Wrangler's
    // setup wizard, which otherwise regenerates this file (and reruns the
    // build a second time) from scratch on every single deploy.
    "not_found_handling": "single-page-application",
    // Without this, the rule above swallows /api/contact and answers it with
    // the app shell — a POST would get HTML back and the form would never
    // reach the Worker. Only /api/* is diverted, so every page and asset is
    // still served straight from `dist` without waking the Worker at all.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // A routing address on this zone, not a mailbox. Email Routing only has
    // to know the address exists for the binding to send as it.
    "CONTACT_FROM": "form@kevink.im",
    "SITE_ORIGIN": "https://kevink.im"
  },
  // Deliberately without `destination_address`: this repository is public, and
  // the recipient is a personal address, so it arrives as the CONTACT_TO
  // secret instead. Nothing is lost by leaving it out — Cloudflare refuses any
  // destination the account has not verified, whatever the Worker asks for.
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  // Per-IP, and per-colo by construction: a distributed flood gets through in
  // proportion to how many data centres it comes from. The point is to make a
  // single script pointed at the endpoint cheap to absorb, not to be a wall.
  // `period` accepts only 10 or 60.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
